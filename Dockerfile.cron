# ═════════════════════════════════════════════════════════════════════
#  Dockerfile.cron — بیلدِ سرویس کرون (جدا از وب‌سرور بات)
#  از همین بیس/اکستنشن‌های Dockerfile اصلی استفاده می‌کند ولی entrypoint
#  آن cron/cron.sh است (فقط کرون‌ها، بدون وب‌سرور).
#  Railway: dockerfilePath این سرویس = Dockerfile.cron
# ═════════════════════════════════════════════════════════════════════
FROM php:8.2-cli

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    zip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libxml2-dev \
    libonig-dev \
    default-mysql-client \
    build-essential \
    autoconf \
    pkg-config \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        gd \
        mysqli \
        pdo \
        pdo_mysql \
        mbstring \
        zip \
        intl \
        bcmath \
        xml \
        soap \
        opcache \
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./

RUN COMPOSER_ALLOW_SUPERUSER=1 composer install \
    --no-dev \
    --prefer-dist \
    --optimize-autoloader \
    --no-interaction \
    --no-progress

COPY . .

CMD ["sh", "/var/www/html/cron/cron.sh"]
